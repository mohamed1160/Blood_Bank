# Supabase Configuration
# Replace with your Supabase Project URL and Public Anon Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI Service Endpoint (Optional future backend for demand forecasting & report OCR)
VITE_AI_API_URL=https://api.your-bloodbank-ai.internal

# Platform Mode: set to 'true' to force demo mode even if Supabase env vars are partially set
VITE_DEMO_MODE=true
